# Sua planilha com dados reais NÃO vai para o GitHub (privacidade).
# Para criar a de exemplo: python criar_planilha_exemplo.py
backend/data/*.xlsx

# Balanços da CVM: arquivos grandes, que qualquer um baixa de novo com
# python3 atualizar_cvm.py (não precisam ir para o GitHub)
backend/data/cvm/
backend/data/*.sqlite

# Arquivos temporários do Python
__pycache__/
*.pyc
.venv/
venv/

# Segredos (credenciais do Google, etc.) nunca vão para o GitHub
.env
secrets.toml
*.json.key

# React (Etapa 4)
node_modules/
dist/
.DS_Store
